aws_region             = "us-east-1"
project_name           = "churnguard"
environment            = "prod"
api_image_tag          = "REPLACE_WITH_GIT_SHA"
mlflow_image_tag       = "REPLACE_WITH_GIT_SHA"
desired_count          = 2
db_instance_class      = "db.t4g.micro"
