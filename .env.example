# Copy to .env and adjust for your environment.
# Never commit real credentials.

# Optional: require X-API-Key on /predict, /predict/batch and /admin/reload.
CHURNGUARD_API_KEY=

# Grafana admin UI password (used only by docker compose).
GRAFANA_ADMIN_PASSWORD=admin

# For AWS-hosted MLflow artifact storage (Terraform reads these via IAM roles).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=